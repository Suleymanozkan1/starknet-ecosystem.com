# Credentials for ai_pipeline.py and the n8n/ workflows.
# construct_timelapse.py and render_timelapse.py need none of these.
#
# ai_pipeline.py uses only the three marked [required]; the rest are for the
# original n8n graphs, which also queue jobs in Airtable and stitch via Shotstack.
# Copy to .env and fill in; .env is gitignored.

# Airtable - job queue holding the Initial/Middle/Final images and prompts.
# Base template: https://airtable.com/appP9Tan7f1mONBsR/shruypLYIy5GxVVMH
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=

# [required by ai_pipeline.py] Google Gemini 2.5 Flash - reads the before/after frames and writes the prompts.
GOOGLE_GEMINI_API_KEY=

# OpenRouter - backs the agent that parses prompts into structured fields.
OPENROUTER_API_KEY=

# [required by ai_pipeline.py] Fal.ai (Nano Banana Pro) - generates the middle "50-60% complete" bridge frame.
FAL_API_KEY=

# [required by ai_pipeline.py] Kie.ai - Veo 3.1 fast (image-to-video clips) and Suno (music bed).
KIE_API_KEY=

# Shotstack - stitches the three clips plus music into the final video.
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

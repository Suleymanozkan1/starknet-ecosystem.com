# Copy to .env and edit. Every value here is optional; the defaults are shown.

# --- Wan2.1 -----------------------------------------------------------------
# Directory holding the Wan2.1 FLF2V checkpoint (roughly 82 GB once downloaded).
WAN_MODEL_PATH=./models/Wan2.1-FLF2V-14B-720P
# Wan task key. Only flf2v-14B does first-last-frame generation.
WAN_TASK=flf2v-14B
# Path to your clone of https://github.com/Wan-Video/Wan2.1, if the `wan`
# package is not installed into the environment.
# WAN_REPO_PATH=/opt/Wan2.1

# --- Mock mode --------------------------------------------------------------
# true: never load Wan2.1, produce a labelled placeholder video instead.
# Use this to exercise the UI and the pipeline before downloading the model.
MOCK_MODE=false

# --- Memory -----------------------------------------------------------------
# Offload submodules to CPU between sampling steps. Cuts peak VRAM from about
# 60 GB to about 20 GB, at the cost of speed. Leave this on unless you have
# an 80 GB card.
OFFLOAD_MODEL=true
# Keep the T5 text encoder on CPU. Saves a few more GB, slows the text pass.
T5_CPU=false

# --- Paths ------------------------------------------------------------------
INPUT_DIR=./inputs
OUTPUT_DIR=./outputs
# Explicit ffmpeg binary. Empty means: system ffmpeg, then the imageio bundle.
FFMPEG_PATH=

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_IMAGE_PIXELS=50000000

# --- Generation defaults ----------------------------------------------------
DEFAULT_SAMPLING_STEPS=40
DEFAULT_GUIDANCE_SCALE=5.5
# Noise schedule shift. The official README recommends 3.0 for 480p.
DEFAULT_SHIFT_720P=16.0
DEFAULT_SHIFT_480P=3.0

# --- Quality gates ----------------------------------------------------------
# Minimum SSIM between the generated last frame and the uploaded AFTER image.
FINAL_FRAME_SSIM_THRESHOLD=0.70
# Below this camera similarity the two uploads are treated as different views.
CAMERA_SIMILARITY_THRESHOLD=0.55

# --- Server -----------------------------------------------------------------
SERVER_NAME=127.0.0.1
SERVER_PORT=7860
SHARE=false
LOG_LEVEL=INFO

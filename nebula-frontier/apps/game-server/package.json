{
  "name": "@nebula/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "bots": "tsx --env-file-if-exists=../../.env src/bots/cli.ts",
    "test": "vitest run --root ../.. apps/game-server"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.17",
    "@colyseus/redis-driver": "^0.18.4",
    "@colyseus/redis-presence": "^0.18.5",
    "@colyseus/schema": "^5.0.34",
    "@colyseus/ws-transport": "^0.18.4",
    "@nebula/authentication": "workspace:*",
    "@nebula/config": "workspace:*",
    "@nebula/database": "workspace:*",
    "@nebula/economy": "workspace:*",
    "@nebula/game-core": "workspace:*",
    "@nebula/shared": "workspace:*",
    "@nebula/telemetry": "workspace:*",
    "@nebula/validation": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "colyseus": "^0.18.8",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@colyseus/testing": "^0.18.6",
    "vitest": "^3.2.7"
  }
}

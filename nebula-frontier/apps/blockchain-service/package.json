{
  "name": "@nebula/blockchain-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "SERVICE_ROLE=blockchain tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "SERVICE_ROLE=blockchain node --enable-source-maps dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "devnet:setup": "tsx --env-file-if-exists=../../.env scripts/devnet-setup.ts",
    "economy:bootstrap": "tsx --env-file-if-exists=../../.env scripts/economy-bootstrap.ts",
    "devnet:e2e": "SERVICE_ROLE=blockchain tsx --env-file-if-exists=../../.env scripts/devnet-e2e.ts",
    "devnet:e2e:mock": "SERVICE_ROLE=blockchain tsx --env-file-if-exists=../../.env scripts/devnet-e2e.ts --mock",
    "nft:mint": "SERVICE_ROLE=blockchain tsx --env-file-if-exists=../../.env scripts/mint-devnet-nft.ts"
  },
  "dependencies": {
    "@nebula/shared": "workspace:*",
    "@nebula/config": "workspace:*",
    "@nebula/economy": "workspace:*",
    "@nebula/telemetry": "workspace:*",
    "@nebula/database": "workspace:*",
    "@nebula/blockchain": "workspace:*",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.0",
    "fastify": "^5.6.0",
    "@solana/kit": "^8.4.0"
  }
}

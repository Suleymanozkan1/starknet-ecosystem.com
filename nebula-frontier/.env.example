# ---------- Core ----------
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://nebula:nebula@localhost:5432/nebula
DB_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
# Long random strings (>=32 chars). Never commit real values.
JWT_SECRET=
GAME_TICKET_SECRET=
INTERNAL_SERVICE_TOKEN=
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost

# ---------- Ports / URLs ----------
API_PORT=8080
GAME_PORT=2567
BLOCKCHAIN_SERVICE_PORT=8090
PUBLIC_GAME_SERVER_URL=ws://localhost:2567
BLOCKCHAIN_SERVICE_URL=http://localhost:8090
REGION=EU

# ---------- Game ----------
GAME_TICK_RATE=20
GAME_PATCH_RATE_MS=50
MAX_PLAYERS_PER_ROOM=100
AOI_RADIUS=140

# ---------- Solana (DEVNET ONLY) ----------
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_COMMITMENT=confirmed
# Treasury public key (base58). Deposits are sent here; payouts come from here.
TREASURY_PUBLIC_KEY=
# Treasury secret: JSON byte array (64 bytes, solana-keygen format) or base58. ONLY for apps/blockchain-service.
# MVP: secure environment secret. Production: KMS/HSM/Secret Manager (see docs/SECURITY.md).
TREASURY_SECRET=
# Optional SPL mint for the reward asset. Empty => rewards settle in native devnet SOL.
REWARD_MINT=
REWARD_MINT_DECIMALS=9

# ---------- Economy (defaults; admin can override at runtime via EconomyConfig) ----------
MIN_WITHDRAWAL=10000000
MAX_WITHDRAWAL=1000000000
DAILY_WITHDRAWAL_LIMIT=2000000000
WITHDRAWAL_COOLDOWN=60
REWARD_POOL=50000000000
SEASON_REWARD_POOL=20000000000
REWARD_BUDGET_RATIO=0.20
MARKETPLACE_FEE=0.075
AUCTION_FEE=0.05
WITHDRAWAL_FEE=0.02

# ---------- Mobile / Push ----------
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8=
PUBLIC_WEB_URL=http://localhost:5173
